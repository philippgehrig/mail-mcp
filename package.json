{
  "name": "mail-mcp",
  "version": "0.1.0",
  "description": "MCP server for IMAP/SMTP email access",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mail-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    ".claude-plugin",
    ".mcp.json",
    "package-lock.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "keywords": [
    "mcp",
    "email",
    "imap",
    "smtp"
  ],
  "author": "Philipp Gehrig",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/philippgehrig/mail-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "imapflow": "^1.3.3",
    "mailparser": "^3.9.8",
    "nodemailer": "^8.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
